    given-names: Naeima
    affiliation: "School of Computer Science and Informatics, Cardiff University"
    email: naeima.hamed@gmail.com
keywords:
  - knowledge graph
  - RDF
  - question answering
  - electric vehicles
  - Wales
  - provenance
  - reproducibility
