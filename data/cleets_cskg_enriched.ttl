cleetsdata:CitationEnrichment_20260908 a prov:Activity ;
    rdfs:label "Citation enrichment of CLEETS-KG, 2026-09-08"@en ;
    rdfs:comment "Added rendered Harvard citations, licence, publisher agents, coverage and access records to every dataset record; described derivation methods as prov:Activity individuals; cited ONS Open Geography for district individuals; typed source-row fingerprints as prov:Entity; added SHACL shapes that keep future records citable. Script: enrich_citations.py with manifest cleets_sources.json."@en ;
    prov:endedAtTime "2026-09-08T11:13:00+00:00"^^xsd:dateTime ;
    prov:wasAssociatedWith cleetsag:CLEETSDataScienceGroup .

