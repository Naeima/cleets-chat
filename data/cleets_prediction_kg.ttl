@prefix cleets: <https://w3id.org/def/cleets#> .
@prefix cleetsdata: <https://w3id.org/def/cleets/data#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cleets:atTurnoverCeiling a owl:DatatypeProperty ;
    rdfs:label "prediction is held at the fleet-turnover ceiling"@en .

cleets:medianScrappageYears a owl:DatatypeProperty ;
    rdfs:label "median scrappage age in years"@en .

cleets:predictedAdoptionShare a owl:DatatypeProperty ;
    rdfs:label "predicted adoption share"@en .

cleets:predictedKeepership a owl:DatatypeProperty ;
    rdfs:label "predicted private BEV count"@en .

cleets:predictedNonBEVStock a owl:DatatypeProperty ;
    rdfs:label "predicted non-battery-electric private stock remaining"@en .

cleets:privateVehicleStock a owl:DatatypeProperty ;
    rdfs:label "private vehicle stock (held at its 2025 Q4 level)"@en .

cleets:scenario a owl:DatatypeProperty ;
    rdfs:label "scenario name"@en .

cleets:terminalTargetShare a owl:DatatypeProperty ;
    rdfs:label "terminal target share"@en .

cleets:thresholdShare a owl:DatatypeProperty ;
    rdfs:label "threshold share"@en .

cleets:turnoverCeilingShare a owl:DatatypeProperty ;
    rdfs:label "fleet-turnover ceiling on the battery-electric share"@en .

cleets:underScenario a owl:ObjectProperty ;
    rdfs:label "under scenario"@en .

cleetsdata:Period2046Q1 a cleets:Quarter,
        cleets:Time ;
    rdfs:label "2046-Q1" ;
    cleets:quarter 1 ;
    cleets:year 2046 ;
    cleets:yearQuarter "2046-Q1" .

