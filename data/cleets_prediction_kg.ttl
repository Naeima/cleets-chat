cleets:midpointShiftQuarters a owl:DatatypeProperty ;
    rdfs:label "scenario midpoint shift in quarters"@en .

cleets:predictedAdoptionShare a owl:DatatypeProperty ;
    rdfs:label "predicted adoption share"@en .

cleets:predictedKeepership a owl:DatatypeProperty ;
    rdfs:label "predicted private BEV count"@en .

cleets:scenario a owl:DatatypeProperty ;
    rdfs:label "scenario name"@en .

cleets:terminalTargetShare a owl:DatatypeProperty ;
    rdfs:label "terminal target share"@en .

cleets:thresholdShare a owl:DatatypeProperty ;
    rdfs:label "threshold share"@en .

cleets:underScenario a owl:ObjectProperty ;
    rdfs:label "under scenario"@en .

