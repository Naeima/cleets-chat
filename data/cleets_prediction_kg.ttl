<https://w3id.org/def/cleets/data#scenario/central> a cleets:Scenario ;
    rdfs:label "central scenario"@en ;
    rdfs:comment "Wales-wide private BEV penetration constrained to 99.0% of the private vehicle stock at 2045 Q4 (midpoint shift -4.07 quarters)."@en ;
    cleets:midpointShiftQuarters -4.075 ;
    cleets:terminalTargetShare 0.99 .

<https://w3id.org/def/cleets/data#scenario/high> a cleets:Scenario ;
    rdfs:label "high scenario"@en ;
    rdfs:comment "Wales-wide private BEV penetration constrained to 99.9% of the private vehicle stock at 2045 Q4 (midpoint shift -26.34 quarters)."@en ;
    cleets:midpointShiftQuarters -26.338 ;
    cleets:terminalTargetShare 0.999 .

<https://w3id.org/def/cleets/data#scenario/low> a cleets:Scenario ;
    rdfs:label "low scenario"@en ;
    rdfs:comment "Wales-wide private BEV penetration constrained to 95.0% of the private vehicle stock at 2045 Q4 (midpoint shift +11.82 quarters)."@en ;
    cleets:midpointShiftQuarters 11.822 ;
    cleets:terminalTargetShare 0.95 .

cleets:EVAdoptionPrediction a owl:Class ;
    rdfs:label "EV adoption prediction"@en ;
    rdfs:comment "Model output for one LAD, quarter and scenario. Not an observed value."@en ;
    rdfs:subClassOf cleets:Observation .

<https://w3id.org/def/cleets/data#activity/diffusion-q2026rev> a prov:Activity ;
    rdfs:label "Bounded logistic diffusion scenario fit"@en ;
    rdfs:comment "Per-LAD logistic curves (rate, midpoint) fitted to the quarterly matched-scope adoption share (VEH0132 private BEV / VEH0105 private licensed vehicles, all body types), recency-weighted, shrunk toward the Wales anchor; one shared midpoint shift per scenario sets the capacity-weighted Wales share at 2045 Q4 to the scenario target. Counts are share x latest VEH0105 private stock held fixed. See notebook Stage 6."@en ;
    prov:endedAtTime "2026-09-10T15:49:25.402854+00:00"^^xsd:dateTime ;
    prov:used <https://w3id.org/def/cleets/data#dataset/VEH0105>,
        <https://w3id.org/def/cleets/data#dataset/VEH0132> .

