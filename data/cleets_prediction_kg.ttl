@prefix cleets: <https://w3id.org/def/cleets#> .
@prefix cleetsdata: <https://w3id.org/def/cleets/data#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cleets:fittedCurveShare a owl:DatatypeProperty ;
    rdfs:label "share on the fitted diffusion curve, before the turnover path is applied"@en .

cleets:onTurnoverPath a owl:DatatypeProperty ;
    rdfs:label "the reported prediction is the turnover path (the lower of the path and the fitted curve)"@en .

cleets:predictedAdoptionShare a owl:DatatypeProperty ;
    rdfs:label "predicted share of private cars that are battery electric"@en .

cleets:predictedKeepership a owl:DatatypeProperty ;
    rdfs:label "predicted private battery-electric cars"@en .

cleets:predictedNonBEVStock a owl:DatatypeProperty ;
    rdfs:label "predicted petrol and diesel cars remaining in private keepership (hybrids included)"@en .

cleets:privateCarStock a owl:DatatypeProperty ;
    rdfs:label "private cars, held at the 2026 Q2 level (VEH9901)"@en .

cleets:salesShareAt2030 a owl:DatatypeProperty ;
    rdfs:label "battery-electric share of new cars in 2030 under the scenario's sales rule"@en .

cleets:scenario a owl:DatatypeProperty ;
    rdfs:label "scenario name"@en .

cleets:scrappageRatesPeriod a owl:DatatypeProperty ;
    rdfs:label "years whose observed scrappage rates the scenario uses"@en .

cleets:terminalTargetShare a owl:DatatypeProperty ;
    rdfs:label "Wales turnover path at 2045 Q4 under the scenario"@en .

cleets:thresholdShare a owl:DatatypeProperty ;
    rdfs:label "threshold share"@en .

cleets:turnoverPathShare a owl:DatatypeProperty ;
    rdfs:label "share on the district's fleet turnover path"@en .

cleets:underScenario a owl:ObjectProperty ;
    rdfs:label "under scenario"@en .

cleetsdata:Period2046Q1 a cleets:Quarter,
        cleets:Time ;
    rdfs:label "2046-Q1" ;
    cleets:quarter 1 ;
    cleets:year 2046 ;
    cleets:yearQuarter "2046-Q1" .

