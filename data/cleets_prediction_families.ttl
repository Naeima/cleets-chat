@prefix cleets: <https://w3id.org/def/cleets#> .
@prefix data: <https://w3id.org/def/cleets/data#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cleets:arrivalRank a owl:DatatypeProperty ;
    rdfs:label "arrival rank (earliest first)"@en .

cleets:betaHi a owl:DatatypeProperty ;
    rdfs:label "upper bound"@en .

cleets:betaLo a owl:DatatypeProperty ;
    rdfs:label "lower bound"@en .

cleets:betaLogRate a owl:DatatypeProperty ;
    rdfs:label "covariate effect on log rate"@en .

cleets:betaMidpointQuarters a owl:DatatypeProperty ;
    rdfs:label "covariate effect on the midpoint (quarters per 1 sd)"@en .

cleets:bevShare2045 a owl:DatatypeProperty ;
    rdfs:label "BEV share of private stock at 2045 Q4"@en .

cleets:bevShareEnd a owl:DatatypeProperty ;
    rdfs:label "BEV share of private stock at horizon end (2053 Q4)"@en .

cleets:chargerShortfall2045 a owl:DatatypeProperty ;
    rdfs:label "public charging devices short of the benchmark at 2045"@en .

cleets:ciWidthYears a owl:DatatypeProperty ;
    rdfs:label "95% interval width of the midpoint (years)"@en .

cleets:constraintClass a owl:DatatypeProperty ;
    rdfs:label "constraint class"@en .

cleets:covariateTerm a owl:DatatypeProperty ;
    rdfs:label "covariate term"@en .

cleets:crossesZero a owl:DatatypeProperty ;
    rdfs:label "interval crosses zero"@en .

cleets:evsPerChargePoint2045 a owl:DatatypeProperty ;
    rdfs:label "BEVs per public charging device at 2045 Q4"@en .

cleets:impliedAnnualReplacementPct a owl:DatatypeProperty ;
    rdfs:label "implied annual replacement (%)"@en .

cleets:lagVsMedianYears a owl:DatatypeProperty ;
    rdfs:label "lag against Welsh median midpoint (years)"@en .

cleets:lagYearsAt80pc a owl:DatatypeProperty ;
    rdfs:label "diffusion lag at 80% BEV share (years behind Wales)"@en .

cleets:mae a owl:DatatypeProperty ;
    rdfs:label "mean absolute error"@en .

cleets:medianScrappageYears a owl:DatatypeProperty ;
    rdfs:label "median scrappage age (years)"@en .

cleets:metricNote a owl:DatatypeProperty ;
    rdfs:label "metric note"@en .

cleets:metricTarget a owl:DatatypeProperty ;
    rdfs:label "metric target"@en .

cleets:midpointPeriod a owl:DatatypeProperty ;
    rdfs:label "midpoint period"@en .

cleets:modelName a owl:DatatypeProperty ;
    rdfs:label "model name"@en .

cleets:nPredictions a owl:DatatypeProperty ;
    rdfs:label "number of held-out predictions"@en .

cleets:notebookStage a owl:DatatypeProperty ;
    rdfs:label "notebook stage"@en .

cleets:observedValue a owl:DatatypeProperty ;
    rdfs:label "observed value"@en .

cleets:paperSection a owl:DatatypeProperty ;
    rdfs:label "paper section"@en .

cleets:pooledR2 a owl:DatatypeProperty ;
    rdfs:label "pooled coefficient of determination over all held-out LAD-quarters"@en .

cleets:predictedValue a owl:DatatypeProperty ;
    rdfs:label "model-predicted value"@en .

cleets:provisionAdequacy a owl:DatatypeProperty ;
    rdfs:label "provision adequacy (benchmark 20 BEVs per device)"@en .

cleets:r2 a owl:DatatypeProperty ;
    rdfs:label "coefficient of determination"@en .

cleets:ratePerQuarter a owl:DatatypeProperty ;
    rdfs:label "logistic rate per quarter"@en .

cleets:reachesShare a owl:DatatypeProperty ;
    rdfs:label "first quarter at which the threshold share is reached"@en .

cleets:residual a owl:DatatypeProperty ;
    rdfs:label "residual (observed minus predicted)"@en .

cleets:residualNonBEV a owl:DatatypeProperty ;
    rdfs:label "residual non-BEV private vehicles at horizon end"@en .

cleets:rmse a owl:DatatypeProperty ;
    rdfs:label "root mean squared error"@en .

cleets:shortfallFrom100pp a owl:DatatypeProperty ;
    rdfs:label "shortfall from 100% (percentage points)"@en .

cleets:shrinkageWeight a owl:DatatypeProperty ;
    rdfs:label "empirical-Bayes shrinkage weight"@en .

cleets:slowestRank a owl:DatatypeProperty ;
    rdfs:label "rank, slowest diffusion first"@en .

