cleetsdata:fuelGroup a qb:DimensionProperty,
        rdf:Property ;
    rdfs:label "fuel group"@en ;
    rdfs:comment "Battery electric, all other fuels together, or all fuels."@en .

cleetsdata:keepershipType a qb:DimensionProperty,
        rdf:Property ;
    rdfs:label "keepership"@en ;
    rdfs:comment "Private keepership, company keepership, or all keepers."@en .

cleetsdata:licensedCars a qb:MeasureProperty,
        rdf:Property ;
    rdfs:label "licensed cars"@en ;
    rdfs:comment "Number of licensed cars."@en .

cleetsdata:yearOfFirstRegistration a qb:DimensionProperty,
        rdf:Property ;
    rdfs:label "year of first registration"@en ;
    rdfs:comment "Calendar year in which the car was first registered (VEH9901) or first used (VEH1111). In VEH9901 the value 2002 stands for 2002 and earlier."@en .

