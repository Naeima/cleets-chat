# CLEETS-CHAT Environment Configuration
# Copy this file to .env and fill in your values

# === Anthropic API ===
# Get your key from: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# === Dashboard Configuration ===
# Model used to humanise answers (optional)
# CLEETS_LLM_MODEL=claude-haiku-4-5-20251001

# Dashboard port (optional, defaults to 8050)
PORT=8050

# === Development ===
# Enable Dash debug mode (optional, true/false)
DASH_DEBUG=false

# === Data Paths (optional, for custom KG locations) ===
# KG_OBSERVED=/path/to/cleets_cskg_enriched.ttl
# KG_PREDICTION=/path/to/cleets_prediction_kg.ttl

# === Logging ===
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Header logo (assets/cleets_logo.png) is shown in a white card; LOGO_CARD=0 puts it directly on the blue banner;
# SHOW_WORDMARK=1 draws the CLEETS wordmark next to the logo as well.
# LOGO_CARD=
# SHOW_WORDMARK=
